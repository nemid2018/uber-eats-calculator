/*
  # Block this site from being embedded in iframes (clickjacking protection)
  X-Frame-Options: DENY

  # Prevent browsers from guessing file types (MIME sniffing attacks)
  X-Content-Type-Options: nosniff

  # Control what info is sent in the Referer header when navigating away
  Referrer-Policy: strict-origin-when-cross-origin

  # Disable access to sensitive browser APIs this app never uses
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

  # Enforce HTTPS for 1 year (only active once deployed to HTTPS)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # Prevent this page from sharing a browsing context with cross-origin pages
  Cross-Origin-Opener-Policy: same-origin

  # Block other sites from loading this site's assets
  Cross-Origin-Resource-Policy: same-origin

  # Content Security Policy — restrict what can run on this page:
  # - Scripts: only from this origin (no inline scripts, no eval)
  # - Styles: this origin + inline (required by Radix UI / Tailwind)
  # - Everything else: this origin only
  # - No iframes of any origin allowed (frame-ancestors 'none')
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
